# ── Gemini API ──────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Email (Gmail SMTP) ──────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sender@gmail.com
SMTP_PASSWORD=your-gmail-app-password-here
EMAIL_FROM=sender@gmail.com
# Birden fazla alici virgülle ayrilir
EMAIL_TO=recipient1@gmail.com,recipient2@example.com

# ── Envanter / Vendor Alias (HASSAS — organizasyonun urun envanterini
# ifsa eder, bu yuzden kaynak kodunda DEGIL, env degiskeninde tutulur) ──
# Format: JSON dizisi / JSON nesne dizisi, TEK SATIRDA.
# Kendi gercek envanterinizle degistirin — asagidaki sadece format ornegidir.
INVENTORY_JSON=["Nginx","Apache Http Server","Openssh"]
VENDOR_ALIASES_JSON=[{"vendor_key":"apache","aliases":["apache tomcat","apache httpd"]}]
